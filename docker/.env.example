# Copy to .env, fill in a password and your Codex tokens, then:
#   docker compose up -d --build
#
# .env holds credentials. It is git-ignored; keep it that way.

# ── the password gate ─────────────────────────────────────────────────────
WEB_USER=dsh
WEB_PASSWORD=change-me

# Where the UI is published. Loopback by default; if you open it to a network,
# put TLS in front of it and name the public authority in PUBLIC_HOST.
BIND_ADDR=127.0.0.1
WEB_PORT=8080
# PUBLIC_HOST=dsh.example.com

# ── the Codex subscription ────────────────────────────────────────────────
# Run ./import-codex-auth.sh to fill these three from a Codex CLI login on
# this machine (~/.codex/auth.json), or paste them yourself.
CODEX_ACCESS_TOKEN=
CODEX_REFRESH_TOKEN=
CODEX_ACCOUNT_ID=

# The container refreshes and rotates these tokens itself and keeps the result
# in its own volume, so it ignores the values above once it has a stored grant.
# Set this to `force` for one start to replace the stored grant after a fresh
# login, then clear it again.
CODEX_SEED=

# The model the very first start writes into settings.yaml; change it later in
# the UI's model menu.
CODEX_MODEL=gpt-5.3-codex-spark

# ── what the agent works on ───────────────────────────────────────────────
# A host directory to edit real files, e.g. /home/you/projects. Left unset,
# the workspace is a Docker volume.
# WORKSPACE_DIR=

# Stamped into the client build; `git rev-parse HEAD` fills it in.
# DSH_CLIENT_COMMIT_HASH=
