# Copy to .env, set a password, then:
#   docker compose up -d --build
#   docker compose exec dsh dsh-login
#
# .env holds the web password. It is git-ignored; keep it that way.

# ── the password gate ─────────────────────────────────────────────────────
WEB_USER=dsh
WEB_PASSWORD=change-me

# Where the UI is published. Loopback by default; if you open it to a network,
# put TLS in front of it and name the public authority in PUBLIC_HOST.
BIND_ADDR=127.0.0.1
WEB_PORT=8080
# PUBLIC_HOST=dsh.example.com

# Settings and credentials are changeable from the browser because the
# password gate above stands in front of them. Set this to 0 to pin the
# configuration plane back to loopback (the model menu and theme stop
# persisting from a remote browser).
TRUST_REMOTE_CONFIG=1

# ── the Codex subscription ────────────────────────────────────────────────
# No token belongs in this file. Sign in from inside the container once it is
# running:  docker compose exec dsh dsh-login
#
# The model the very first start writes into settings.yaml; change it later in
# the UI's model menu.
CODEX_MODEL=gpt-5.3-codex-spark

# ── what the agent works on ───────────────────────────────────────────────
# A host directory to edit real files, e.g. /home/you/projects. Left unset,
# the workspace is a Docker volume.
# WORKSPACE_DIR=

# Stamped into the client build; `git rev-parse HEAD` fills it in.
# DSH_CLIENT_COMMIT_HASH=
