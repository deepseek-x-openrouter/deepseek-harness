# A Postgres database for the agent to read. Copy to db.env; compose picks it
# up if it exists and ignores it if it does not.
#
# These are libpq's own variable names, which is the whole point: `psql`,
# psycopg and DuckDB's postgres extension all read them, so every route into
# the database connects with no connection string.
#
#   docker compose exec dsh psql -c '\dt'
#   docker compose exec dsh duckdb -c "ATTACH '' AS pg (TYPE postgres, READ_ONLY); show all tables"
#
# Write only the lines you need — libpq rejects an empty value for some of
# these (PGSSLMODE among them), so a blank line is worse than a missing one.
#
# db.env holds a password. It is git-ignored; keep it that way.

PGHOST=db
PGPORT=5432
PGDATABASE=market
PGUSER=readonly
PGPASSWORD=

# require, verify-ca or verify-full over any network you do not control.
# PGSSLMODE=require

# Give the agent a read-only role. Anything it can write, it can drop.
